# Copie para ".env" (na raiz, junto de manage.py) e preencha antes de
# rodar. NUNCA suba o ".env" real (com segredos de verdade) para o Git.

DEBUG=True
SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres via Docker Compose. Para rodar SEM Docker durante o
# desenvolvimento, comente esta linha — o settings.py cai para SQLite
# automaticamente.
DATABASE_URL=postgres://learning_user:learning_pass@db:5432/personalized_learning

# Só necessário se o frontend virar uma SPA em outra origem (ex.: React
# rodando em localhost:3000). Deixe vazio para Django Templates.
CORS_ALLOWED_ORIGINS=

# Provedor de IA — a chave nunca é lida fora de ai/provider.py.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
